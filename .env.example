# ── Mowazaf environment variables ────────────────────────────────────────────
# Copy to .env and fill in.

# Required — fail-closed if missing or blank.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MOWAZAF_SECRET=change_me_to_a_random_64_char_string

# CORS origins (comma-separated)
MOWAZAF_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# PostgreSQL (used by docker-compose)
MOWAZAF_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mowazaf

# Redis (for future background jobs / Hermes runtime coordination)
MOWAZAF_REDIS_URL=redis://localhost:6379/0

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Get these from https://developers.facebook.com/
MOWAZAF_WHATSAPP_TOKEN=
MOWAZAF_WHATSAPP_PHONE_ID=           # the business phone_number_id
MOWAZAF_WHATSAPP_VERIFY_TOKEN=        # set in the Meta dashboard

# For onboarding/debug UI: build public webhook callback URLs (no hard-coded trycloudflare)
MOWAZAF_PUBLIC_BASE_URL=
MOWAZAF_WHATSAPP_WEBHOOK_PATH=/webhook/whatsapp

# ── Hermes runtime (V2 — not used in V1 stub) ───────────────────────────────
MOWAZAF_HERMES_API_URL=http://localhost:9119
MOWAZAF_HERMES_API_KEY=

# ── Token ───────────────────────────────────────────────────────────────────
MOWAZAF_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
